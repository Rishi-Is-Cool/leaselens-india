# Copy to .env and fill in real values. Never commit .env.

# --- Backend ---
APP_NAME=LeaseLens API
ENVIRONMENT=development

# Supabase Postgres, via SQLAlchemy + psycopg3.
# Get it from: Supabase dashboard -> Project Settings -> Database -> Connection string.
# Take the URI, then replace the "postgresql://" scheme with "postgresql+psycopg://".
#
# Prefer the *Session pooler* or *Transaction pooler* URI: the direct-connection host
# (db.<ref>.supabase.co) is IPv6-only on new projects and will fail on IPv4-only networks.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- LLM baseline (Phase 2), any OpenAI-compatible FREE-tier provider ---
# Groq:    https://api.groq.com/openai/v1              model e.g. llama-3.3-70b-versatile
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai   model e.g. gemini-2.0-flash
# Check the provider's current free-tier limits; the runner throttles and resumes from a cache.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_MIN_INTERVAL_SECONDS=2.5

# --- LLM (used from Phase 4 onward; not required for Phase 0) ---
ANTHROPIC_API_KEY=

# --- Frontend (Vite reads VITE_-prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000
